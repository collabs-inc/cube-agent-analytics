{
  "name": "cube-agent-analytics",
  "displayName": "Cube Agent Analytics",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "DATABASE_URL=${ANALYTICS_DATABASE_URL:-pglite:./data/pglite} agent-native dev",
    "build": "agent-native build && tsx scripts/emit-netlify-dashboard-report-cron.ts",
    "start": "agent-native start",
    "test": "vitest --run",
    "test:bigquery-emulator": "vitest --run --config vitest.bigquery.config.ts",
    "format.fix": "oxfmt --write .",
    "typecheck": "agent-native typecheck",
    "migrate:production": "tsx scripts/migrate-production.ts",
    "journey:capture": "tsx scripts/journey-capture.ts",
    "source-index": "tsx scripts/build-source-index.ts",
    "backfill:first-party-bigquery": "tsx scripts/first-party-analytics-bigquery-backfill.ts",
    "action": "agent-native action",
    "script": "agent-native script",
    "agent-native:doctor": "agent-native doctor",
    "cube:build": "node cube/build.mjs",
    "cube:start": "node cube/start.mjs"
  },
